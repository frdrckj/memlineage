from typing import Any

class MemlineageError(Exception): ...

class Decision:
    action: str
    rule_id: str
    retrieval_weight: float | None
    def __repr__(self) -> str: ...

class Firewall:
    @staticmethod
    def from_file(path: str) -> Firewall: ...
    def check(self, record: dict[str, Any]) -> Decision: ...
    def filter_read_ids(self, records: list[dict[str, Any]]) -> list[str]: ...
    def approve(self, id: str) -> None: ...
    def reject(self, id: str) -> None: ...
